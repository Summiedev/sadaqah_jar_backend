APP_NAME=Mizan API
ENV=development

# Local PostgreSQL example
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mizan

# Local Redis example (or replace with Upstash rediss://...)
REDIS_URL=redis://127.0.0.1:6379/0

# Use a long random string (32+ chars)
JWT_SECRET=change_me_to_a_strong_secret_at_least_32_characters

ACCESS_TOKEN_EXPIRE_MINUTES=15

# Comma-separated list of allowed frontend origins
# For Flutter web local run:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For hosted web app:
# CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=

# SMTP for transactional emails (verification, password reset)
# Leave SMTP_HOST empty to skip real sends (messages are logged)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@mizan.app

# Public URL for building email links (no trailing slash)
APP_URL=http://localhost:8000

# Resend API key for transactional emails (verification, password reset)
# Get yours at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Google OAuth (replace placeholders with real values)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Firebase Cloud Messaging (server-side service-account JSON; do not commit it)
FCM_SERVICE_ACCOUNT_PATH=
